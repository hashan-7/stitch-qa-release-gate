{
  "name": "stitchqa/php-unsupported-fixture",
  "description": "Unsupported PHP fixture for Stitch QA UX validation",
  "type": "project",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "StitchQaFixture\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StitchQaFixture\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
