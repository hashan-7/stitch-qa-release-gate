# ==============================================================================
# Stitch QA - AWS Bedrock & Multi-Agent Release Gate Configuration
# ==============================================================================
#
# This file provides a template of all environment variables supported by Stitch QA.
# To configure your local environment, copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT:
# - If you don't provide AWS credentials, Stitch QA will seamlessly run in
#   offline mode using its built-in deterministic intelligence engine.
# - Never commit your real '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Credentials
# ------------------------------------------------------------------------------
# Your AWS IAM access keys with permissions to call Amazon Bedrock.
# Required IAM Action: bedrock:InvokeModel
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Optional: Use a configured AWS CLI profile instead of explicit access keys
# AWS_PROFILE=default

# ------------------------------------------------------------------------------
# 2. Bedrock Foundation Models (Agent Role Mapping)
# ------------------------------------------------------------------------------
# Agent 1: Source Quality Intelligence Analyst (Deep AST & security scan)
BEDROCK_MODEL_SOURCE_QUALITY=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Agent 2: Runtime Quality Intelligence Analyst (Test failure log diagnosis)
BEDROCK_MODEL_RUNTIME_QUALITY=amazon.nova-lite-v1:0

# Agent 3: Defect Resolution Intelligence Analyst (Repair contract generation)
BEDROCK_MODEL_DEFECT_RESOLUTION=amazon.nova-pro-v1:0

# Agent 4: Repair Assurance Intelligence Analyst (Precise code patch planning)
BEDROCK_MODEL_REPAIR_ASSURANCE=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Agent 5: Strands Decider 2B Gate Model (Discrete confidence release decision)
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21

# ------------------------------------------------------------------------------
# 3. Execution & Testing Overrides
# ------------------------------------------------------------------------------
# Set to 'true' to force the offline deterministic engine even when AWS keys exist.
# Useful for testing local fallback behavior and reproducible CI runs.
STITCH_MOCK_BEDROCK=false
